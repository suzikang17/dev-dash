# Swift / SwiftPM
.build/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/

# macOS
.DS_Store

# DevDash local state (todos, recaps, server logs)
.devdash/

# oh-my-claudecode state
.omc/
# override the global ~/.gitignore_global rule that excludes the whole .claude/ dir
!.claude/
.claude/*
# but track shared project settings (hooks/permissions installed by HookInstaller)
!.claude/settings.json

# DevDash.app — track Info.plist only; ignore binary + generated files
DevDash.app/Contents/MacOS/DevDash
DevDash.app/Contents/Resources/
DevDash.app/Contents/_CodeSignature/
DevDash-*.zip
**/.index.json
